# Copy to ".env" for local dev. Vite only exposes vars prefixed with VITE_ to the app.
# The base URL of the backend API. Never hard-code this in code — always read it from here.
# Local dev default:
VITE_API_URL=http://localhost:8000
# In production (Vercel), set this to your Render backend URL, e.g. https://pm-copilot-api.onrender.com

# Optional: Google Sign-In. The OAuth 2.0 Web Client ID from Google Cloud Console.
# Leave blank to disable the "Continue with Google" button (email/password still works).
VITE_GOOGLE_CLIENT_ID=

# Optional: error tracking. A Sentry DSN (sentry.io → project settings → Client Keys).
# Leave blank to disable — no monitoring code is loaded.
VITE_SENTRY_DSN=
