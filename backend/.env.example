# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Text generation provider ---
# LLM_PROVIDER selects who generates PRDs/stories: "gemini" or "groq".
#   groq   = free API, NO credit card (https://console.groq.com) — recommended if the
#            Gemini free tier isn't available in your region.
#   gemini = Google Gemini (https://aistudio.google.com/apikey).
LLM_PROVIDER=groq

# Groq (needed when LLM_PROVIDER=groq). Key looks like gsk_...
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (needed when LLM_PROVIDER=gemini). Leave blank if using Groq.
# Note: gemini-2.5-flash is not available to newer API keys — use gemini-2.0-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (RAG / Phase 4) ---
# "local" uses fastembed on your machine (offline, no key, 384-dim) — the default.
# "gemini" uses text-embedding-004 (768-dim) and requires GEMINI_API_KEY + a schema change.
EMBED_PROVIDER=local

# PostgreSQL connection string.
# For Neon (recommended): copy the connection string from your Neon dashboard, then
# prefix it with "postgresql+psycopg://" (psycopg3). It MUST include sslmode=require.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Secret used to sign JWT tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# How long a login token stays valid (in minutes). 1440 = 24 hours.
JWT_EXPIRE_MINUTES=1440

# Optional: Google Sign-In. The OAuth 2.0 Web Client ID from Google Cloud Console
# (same value as the frontend's VITE_GOOGLE_CLIENT_ID). Leave blank to disable.
GOOGLE_CLIENT_ID=

# The URL of the frontend, used to allow CORS requests from the browser.
# Local dev default below; in production set this to your Vercel URL.
FRONTEND_URL=http://localhost:5173
