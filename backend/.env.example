# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Text generation provider ---
# LLM_PROVIDER picks who answers FIRST: "gemini" or "groq". If it fails (quota, overload,
# retired model) the app falls back to backup models, then to the other provider if it
# has a key — so setting both keys is the most reliable setup.
#   gemini = Google Gemini (https://aistudio.google.com/apikey).
#   groq   = free API, no credit card (https://console.groq.com).
LLM_PROVIDER=gemini

# Groq (needed when LLM_PROVIDER=groq). Key looks like gsk_...
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (needed when LLM_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is out of quota / overloaded / retired.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Embeddings (RAG / Phase 4) ---
# "local" uses fastembed on your machine (offline, no key, 384-dim) — the default.
# "gemini" uses text-embedding-004 (768-dim) and requires GEMINI_API_KEY + a schema change.
EMBED_PROVIDER=local

# PostgreSQL connection string.
# For Neon (recommended): copy the connection string from your Neon dashboard, then
# prefix it with "postgresql+psycopg://" (psycopg3). It MUST include sslmode=require.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Secret used to sign JWT tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# How long a login token stays valid (in minutes). 10080 = 7 days. Sessions slide: each visit
# refreshes the token, so only a week of inactivity signs someone out.
JWT_EXPIRE_MINUTES=10080

# Optional: Google Sign-In. The OAuth 2.0 Web Client ID from Google Cloud Console
# (same value as the frontend's VITE_GOOGLE_CLIENT_ID). Leave blank to disable.
GOOGLE_CLIENT_ID=

# The URL(s) of the frontend, used to allow CORS requests from the browser. Comma-separate
# several (e.g. production + a custom domain); no trailing slash. In production, your Vercel URL.
FRONTEND_URL=http://localhost:5173
# Optional: also allow Vercel preview deploys of YOUR project, as a regex. Example:
#   ^https://pm-copilot-ai-[a-z0-9-]+-anshul-92e9\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# --- Abuse protection: AI requests per hour (public chat per IP, generation per user) ---
CHAT_RATE_LIMIT_PER_HOUR=30
GENERATION_RATE_LIMIT_PER_HOUR=40

# --- Optional error tracking: a Sentry DSN. Blank = disabled. ---
SENTRY_DSN=
